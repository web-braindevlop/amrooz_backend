# Database Configuration (MySQL / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=am_rooz_cl

# Application Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auth secrets — generate your own, at least 32 random characters each, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same value for both, never commit real values, rotate for production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# First admin account (used once by `npm run seed:admin`, then discard)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
