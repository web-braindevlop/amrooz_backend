# Database Configuration (MySQL / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=u278943707_am_rooz_cl
# XAMPP / phpMyAdmin default root password is empty. If you set one, put it here.
DB_PASSWORD=your_database_password_here
DB_DATABASE=u278943707_am_rooz_cl

# Application Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auth secrets (dev-only values, generated locally — rotate for production and
# never commit real production secrets to source control)
JWT_ACCESS_SECRET=generate_your_own_secret_here
JWT_REFRESH_SECRET=generate_your_own_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email Configuration
# Hostinger SMTP - Use smtp.hostinger.com (mail.amroozcollection.com DNS may not resolve)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@amroozcollection.com
MAIL_PASS=your_email_password_here
MAIL_FROM=Amrooz Collection <no-reply@amroozcollection.com>
