{
  "name": "clothing-store-backend",
  "version": "1.0.0",
  "description": "Backend API for Amrooz Collection clothing store",
  "author": "Amrooz Collection",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register src/seed-admin.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/throttler": "^6.3.1",
    "@nestjs/typeorm": "^10.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "multer": "^2.3.0",
    "@nestjs/platform-express": {
      "multer": "^2.3.0"
    },
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "@nestjs/typeorm": {
      "uuid": "^11.1.1"
    },
    "lodash": "^4.18.0",
    "picomatch": "^4.0.4",
    "glob": "^10.5.0",
    "qs": "^6.16.0",
    "file-type": "^21.3.2",
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1"
  }
}
